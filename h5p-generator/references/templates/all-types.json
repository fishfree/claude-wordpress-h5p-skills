{
  "_meta": {
    "description": "所有 H5P 内容类型的模板库",
    "source": "h5p.org 官方示例 + UBC 示例",
    "validated": "2026-01-24"
  },

  "fill-in-blanks": {
    "library": "H5P.Blanks 1.14",
    "structure": {
      "questions": ["<p>包含 *填空* 单词的文本。</p>"],
      "text": "<p>给学习者的说明。</p>",
      "behaviour": {
        "caseSensitive": false,
        "acceptSpellingErrors": true,
        "showSolutionsRequiresInput": true,
        "enableRetry": true,
        "enableSolutionsButton": true,
        "enableCheckButton": true
      }
    },
    "blank_syntax": {
      "single": "*answer*",
      "alternatives": "*answer1/answer2*",
      "tip": "*answer:提示文本*"
    }
  },

  "dialog-cards": {
    "library": "H5P.Dialogcards 1.9",
    "structure": {
      "title": "<p>卡片集标题</p>",
      "description": "<p>使用说明</p>",
      "dialogs": [
        {
          "text": "<p style='text-align:center;'>正面</p>",
          "answer": "<p style='text-align:center;'>背面</p>",
          "tips": {}
        }
      ],
      "behaviour": {
        "enableRetry": true,
        "disableBackwardsNavigation": false,
        "scaleTextNotCard": false,
        "randomCards": false,
        "maxProficiency": 5
      }
    }
  },

  "single-choice-set": {
    "library": "H5P.SingleChoiceSet 1.11",
    "structure": {
      "choices": [
        {
          "question": "题目内容？",
          "answers": ["正确答案", "错误答案 1", "错误答案 2"]
        }
      ],
      "behaviour": {
        "timeoutCorrect": 1000,
        "timeoutWrong": 1000,
        "soundEffectsEnabled": false,
        "enableRetry": true,
        "enableSolutionsButton": true,
        "passPercentage": 60
      }
    },
    "note": "第一个答案始终为正确答案"
  },

  "true-false": {
    "library": "H5P.TrueFalse 1.8",
    "structure": {
      "question": "<p>待判断的陈述</p>",
      "correct": "true",
      "l10n": {
        "trueText": "正确",
        "falseText": "错误"
      },
      "feedbackOnCorrect": "回答正确！解释……",
      "feedbackOnWrong": "回答错误。正确答案是……"
    },
    "note": "correct 的值必须是字符串 'true' 或 'false'"
  },

  "mark-the-words": {
    "library": "H5P.MarkTheWords 1.11",
    "structure": {
      "taskDescription": "<p>点击正确的单词！</p>",
      "textField": "文本中用 *星号* 标记 *正确* 的单词。",
      "behaviour": {
        "enableRetry": true,
        "enableSolutionsButton": true,
        "enableCheckButton": true,
        "showScorePoints": true
      }
    },
    "mark_syntax": "*word*"
  },

  "summary": {
    "library": "H5P.Summary 1.10",
    "structure": {
      "intro": "<p>请选择正确的陈述。</p>",
      "summaries": [
        {
          "summary": [
            "<p>正确陈述（第一项）</p>",
            "<p>错误陈述 1</p>",
            "<p>错误陈述 2</p>"
          ],
          "tip": "可选提示"
        }
      ]
    },
    "note": "每组 summary 中第一条陈述始终为正确答案"
  },

  "accordion": {
    "library": "H5P.Accordion 1.0",
    "dependencies": ["H5P.AdvancedText 1.1", "FontAwesome 4.5"],
    "structure": {
      "panels": [
        {
          "title": "章节标题",
          "content": {
            "params": {
              "text": "<p>这里填写内容</p>"
            },
            "library": "H5P.AdvancedText 1.1"
          }
        }
      ],
      "hTag": "h2"
    }
  },

  "question-set": {
    "library": "H5P.QuestionSet 1.20",
    "structure": {
      "introPage": {
        "showIntroPage": true,
        "title": "测验标题",
        "introduction": "<p>使用说明</p>"
      },
      "progressType": "dots",
      "passPercentage": 60,
      "questions": [
        {
          "params": {},
          "library": "H5P.TrueFalse 1.8",
          "subContentId": "unique-id"
        }
      ],
      "texts": {
        "prevButton": "上一题",
        "nextButton": "下一题",
        "finishButton": "完成",
        "textualProgress": "第 @current 题，共 @total 题"
      },
      "endGame": {
        "showResultPage": true,
        "showSolutionButton": true,
        "showRetryButton": true,
        "message": "总分 @total，你获得了 @score 。"
      }
    }
  }
}
